<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
	<OutputType>WinExe</OutputType>
	<UseWPF>false</UseWPF>
	  <TargetFramework>net8.0-windows</TargetFramework>
	<StartupObject>AIDemon2.Program</StartupObject>
	<Company>Mysttic</Company>
	<PackageIcon>AIDemon2.png</PackageIcon>
  <Platforms>AnyCPU;x64</Platforms>
	<ApplicationManifest>app.manifest</ApplicationManifest>
	<!-- To JEDYNA właściwość, która decyduje o bitowości wyjścia — trafia do kompilatora
	     jako /platform. Przekazanie -p:Platform=x64 samo z siebie nic tu nie zmienia:
	     SDK wyprowadza PlatformTarget z Platform tylko wtedy, gdy PlatformTarget jest puste. -->
	<PlatformTarget>x64</PlatformTarget>
	<!-- Zawęża restore do jednej platformy. UWAGA: wbrew temu, co mówił poprzedni komentarz
	     w tym miejscu, samo RuntimeIdentifiers NIE przycina katalogu runtimes/ w wyjściu
	     zwykłego `dotnet build` — tam nadal ląduje komplet 25 platform (~130 MB). Przycięcie
	     następuje dopiero przy buildzie pod konkretny RID (-r win-x64 lub RuntimeIdentifier). -->
	<RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
	<!-- Katalogi tłumaczeń komunikatów EF Core; aplikacja jest jednojęzyczna. -->
	<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Properties\ProgrammingLanguages.json" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Properties\ProgrammingLanguages.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AnimatedImage.Avalonia" />
    <PackageReference Include="Avalonia" />
	<PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
    <PackageReference Condition="'$(Configuration)' == 'Debug'" Include="Avalonia.Diagnostics" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="CsvHelper" />
    <PackageReference Include="Material.Icons.Avalonia" />
    <PackageReference Include="MessageBox.Avalonia" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" />
    <!-- .Core, NIE Microsoft.EntityFrameworkCore.Sqlite: ten drugi ciągnie tranzytywnie
         SQLitePCLRaw.bundle_e_sqlite3, który konkuruje z bundle_e_sqlcipher poniżej.
         O tym, który natywny SQLite wygrywa, decydowało wtedy porównanie wersji assembly
         przez MSBuild — a przy przegranej SQLCipher połączenie z Password= rzuca wyjątek. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite.Core" />
	<PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Migrations\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AIDemon2.Tests" />
  </ItemGroup>

</Project>
