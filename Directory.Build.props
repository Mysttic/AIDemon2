<Project>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!--
    Ostrzeżenia kompilatora jako błędy.

    Projekt miał 33 miejsca z ostrzeżeniami (głównie nullable i przestarzałe API
    dialogów Avalonii). Dopóki ostrzeżenia są tylko ostrzeżeniami, kolejne wtapiają
    się w szum i nikt ich nie czyta. Po wyzerowaniu utrzymanie zera jest darmowe.

    Warunek na .csproj: wapproj (pakowanie MSIX) sypie ostrzeżeniami z targetów
    DesktopBridge, na które nie mamy wpływu.
  -->
  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- NU19xx to ostrzeżenia o podatnościach w pakietach. Zależą od zewnętrznej
         bazy CVE, więc jako błędy wywracałyby CI bez żadnej zmiany w repozytorium.
         Mają być widoczne, ale nie blokować. -->
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

  <!-- Centralne zarządzanie wersjami pakietów jest włączane w Directory.Packages.props,
       razem z wyjątkiem dla wapproj. Ustawianie tego tutaj nie działa: tamten plik
       jest importowany później i nadpisuje wartość stąd. -->

</Project>
