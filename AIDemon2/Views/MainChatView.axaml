<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
			 xmlns:vm="clr-namespace:AIDemon2.ViewModels"
             x:Class="AIDemon2.Views.MainChatView">

	<Grid RowDefinitions="*,Auto">

		<!-- Lista wiadomości -->
		<ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" x:Name="ChatScrollViewer">
			<ItemsControl ItemsSource="{Binding Messages}">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<VirtualizingStackPanel />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>

				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<!-- Klasy zamiast konwertera koloru: przenosi wygląd do arkusza stylów
						     i pozwala wystylizować cały dymek, nie tylko jego tło. -->
						<Border Classes="bubble"
								Classes.user="{Binding IsUserMessage}"
								Classes.ai="{Binding !IsUserMessage}"
                                HorizontalAlignment="{Binding IsUserMessage, Converter={StaticResource MessageAlignmentConverter}}">
							<Grid>
								<Grid.RowDefinitions>
									<!-- Wiersz na główną treść wiadomości -->
									<RowDefinition />
									<!-- Wiersz na dolny pasek (data, ikony) -->
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>

								<!-- Górna część (treść). ScrollViewer z MaxHeight, bo długa
								     odpowiedź z kodem rozciągała pojedynczy dymek na kilka
								     ekranów i wypychała resztę rozmowy poza widok. -->
								<ScrollViewer Grid.Row="0" MaxHeight="420"
											  VerticalScrollBarVisibility="Auto"
											  HorizontalScrollBarVisibility="Disabled">
									<TextBlock Text="{Binding OriginalMessage}"
											   Classes="body"
											   MaxWidth="520"/>
								</ScrollViewer>

								<!-- Dolna część (data + ikona modyfikacji, przycisk Resend) -->
								<Grid Grid.Row="1" Margin="0,5,0,0">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="Auto"/>
									</Grid.ColumnDefinitions>

									<!-- Nazwa modelu AI (pokazuj tylko, gdy to nie jest wiadomość użytkownika) -->
									<!-- Przycięcie i odstęp: długie identyfikatory modeli
									     (np. "openai/gpt-oss-20b:free") sklejały się ze
									     znacznikiem czasu w sąsiedniej kolumnie. -->
									<TextBlock Text="{Binding AIModel}"
											   Grid.Column="0"
											   Classes="model"
											   TextTrimming="CharacterEllipsis"
											   Margin="0,0,10,0"
											   VerticalAlignment="Center"
											   IsVisible="{Binding IsUserMessage, Converter={StaticResource BoolInverseToVisibilityConverter}}"/>

									<!-- Data i ewentualna ikona modyfikacji w prawym dolnym rogu.
									     Klasa "meta" daje monospace — cyfry o stałej szerokości
									     nie przeskakują przy każdej sekundzie. Wcześniejszy
									     Foreground="Gray" dawał na dymku 2.26:1, czyli poniżej
									     progu czytelności WCAG AA. -->
									<StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right">
										<!-- Data -->
										<TextBlock Text="{Binding CreationDate, Converter={StaticResource UtcToLocalTimeConverter}, StringFormat='HH:mm:ss'}"
												   Classes="meta"/>
										<TextBlock Text="{Binding ModificationDate, Converter={StaticResource UtcToLocalTimeConverter}, StringFormat='HH:mm:ss'}"
												   Classes="meta"
												   IsVisible="{Binding IsModified, Converter={StaticResource BoolToVisibilityConverter}}"/>
									
									</StackPanel>
								</Grid>
							</Grid>
						</Border>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>

	</Grid>
</UserControl>
